{
  "name": "im-upping-my-pdoom",
  "version": "0.1.0",
  "private": true,
  "description": "Version-centered code-video production workspace",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "project:new": "node scripts/project-new.mjs",
    "version:new": "node scripts/version-new.mjs",
    "catalog": "node scripts/catalog.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:source": "node scripts/verify.mjs --source-only",
    "verify:media": "node scripts/verify.mjs --probe",
    "analyze": "python3 scripts/analyze.py",
    "transcribe": "python3 scripts/transcribe.py",
    "render": "node scripts/render.mjs",
    "render:stills": "node scripts/render.mjs --stills",
    "render:smoke": "node scripts/render.mjs --smoke",
    "register": "node scripts/register.mjs",
    "verify:playback": "node scripts/playback.mjs",
    "build:renderer": "node scripts/build.mjs",
    "audio:prepare": "node scripts/audio.mjs",
    "audio:separate": "node scripts/audio.mjs --stage separate",
    "audio:align": "node scripts/audio.mjs --stage align",
    "audio:features": "node scripts/audio.mjs --stage features"
  },
  "dependencies": {
    "opentype.js": "2.0.0",
    "playwright": "1.63.0",
    "three": "0.186.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/opentype.js": "1.3.10",
    "@types/three": "0.186.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
